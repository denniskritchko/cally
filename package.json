{
  "name": "cally",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:push": "pnpm --filter @cally/api run db:push",
    "db:studio": "pnpm --filter @cally/api run db:studio"
  }
}
