# --- Server ---
PORT=3000
# Public URL of the deployed app (no trailing slash). Used for OAuth redirects and the feed URL.
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://localhost:5432/cally

# --- Secrets ---
# 32 random bytes, hex encoded. Generate with: openssl rand -hex 32
# Encrypts Canvas/Google tokens at rest. Rotating it invalidates every stored token.
ENCRYPTION_KEY=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Web application client. Authorized redirect URI: $APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Canvas ---
CANVAS_BASE_URL=https://canvas.sfu.ca
# IANA timezone used for due-date rendering in ICS and Google.
DEFAULT_TIMEZONE=America/Vancouver

# --- Sync ---
# Cron expression for the periodic pull (token/feed connections). Extension pushes are independent of this.
SYNC_CRON=*/15 * * * *
